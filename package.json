{
  "name": "mozzai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "deploy": "npm run check && npm test && npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.2-beta",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
